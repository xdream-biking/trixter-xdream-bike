<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Trixter.XDream.Diagnostics.Program</StartupObject>
    <ApplicationIcon>White-X.ico</ApplicationIcon>
    <Authors>David Mason</Authors>
    <Description>Diagnostic utility for reading the status of a Trixter X-Dream exercise bike and setting its resistance.</Description>
    <Copyright>(C) David Mason 2021-2026</Copyright>
    <Version>1.5.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageLicenseFile>..\LICENSE.rtf</PackageLicenseFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PackageProjectUrl>https://github.com/xdream-biking/trixter-xdream-bike</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Configurations>Debug;Release;Signed Release</Configurations>
  </PropertyGroup>
  <ItemGroup>

    <None Remove="Resources\Refresh.png" />
    <None Remove="Resources\update-available.png" />
    <None Remove="Resources\update-check-due.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="White-X.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Refresh.png" />
    <EmbeddedResource Include="Resources\update-available.png" />
    <EmbeddedResource Include="Resources\update-check-due.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trixter.XDream.API\Trixter.XDream.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Condition="$(Configuration)=='Signed Release'" Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call ..\Scripts\sign-tool.cmd &quot;$(TargetPath)&quot; &quot;Trixter X-Dream Diagnostic Utilities&quot; " />
  </Target>
</Project>